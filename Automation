      "parameters": {
        "jsCode": "// Finds birthdays and work anniversaries for today (Asia/Kolkata),\n// matching day + month only, and skips anything already logged as sent today.\nconst ZONE = 'Asia/Kolkata';\nconst now = DateTime.now().setZone(ZONE);\nconst todayIso = now.toFormat('yyyy-MM-dd');\n\nfunction mk(y, mo, d) {\n  const dt = DateTime.fromObject({ year: y, month: mo, day: d }, { zone: ZONE });\n  return dt.isValid ? dt : null;\n}\n\n// Accepts YYYY-MM-DD, DD/MM/YYYY, DD-MM-YYYY, Sheets serial numbers, or other parseable text.\nfunction parseDate(value) {\n  if (value === null || value === undefined || value === '') return null;\n  if (typeof value === 'number') {\n    const d = DateTime.fromObject({ year: 1899, month: 12, day: 30 }, { zone: ZONE }).plus({ days: Math.floor(value) });\n    return d.isValid ? d : null;\n  }\n  const s = String(value).trim();\n  let m = s.match(/^([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})/);\n  if (m) return mk(Number(m[1]), Number(m[2]), Number(m[3]));\n  m = s.match(/^([0-9]{1,2})[-/.]([0-9]{1,2})[-/.]([0-9]{4})/);\n  if (m) return mk(Number(m[3]), Number(m[2]), Number(m[1]));\n  const js = new Date(s);\n  if (!isNaN(js.getTime())) return mk(js.getFullYear(), js.getMonth() + 1, js.getDate());\n  return null;\n}\n\nfunction matchesToday(d) {\n  if (d.month === now.month && d.day === now.day) return true;\n  // 29 Feb dates are celebrated on 28 Feb in non-leap years\n  return d.month === 2 && d.day === 29 && !now.isInLeapYear && now.month === 2 && now.day === 28;\n}\n\nfunction clean(v) {\n  return v === null || v === undefined ? '' : String(v).trim();\n}\n\n// Build the set of notifications already sent today\nconst alreadySent = new Set();\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  if (r['Employee ID'] === undefined || r['Employee ID'] === '') continue;\n  if (!clean(r['Notification Status']).toLowerCase().startsWith('sent')) continue;\n  const d = parseDate(r['Date']);\n  if (!d || d.toFormat('yyyy-MM-dd') !== todayIso) continue;\n  alreadySent.add(clean(r['Employee ID']) + '|' + clean(r['Occasion']).toLowerCase());\n}\n\nconst out = [];\nfor (const item of $('Get Employees').all()) {\n  const e = item.json || {};\n  const employeeId = clean(e['Employee ID']);\n  const employeeName = clean(e['Employee Name']);\n  if (!employeeId || !employeeName) continue;\n\n  const base = {\n    employeeId,\n    employeeName,\n    firstName: employeeName.split(' ')[0],\n    email: clean(e['Email Address']),\n    phone: clean(e['Phone Number']),\n    department: clean(e['Department']),\n    managerName: clean(e['Manager Name']),\n    managerEmail: clean(e['Manager Email']),\n    date: todayIso,\n  };\n\n  const dob = parseDate(e['Date of Birth']);\n  if (dob && matchesToday(dob)) {\n    const key = employeeId + '|birthday';\n    if (!alreadySent.has(key)) {\n      alreadySent.add(key);\n      out.push({ json: { ...base, occasion: 'Birthday', years: 0 } });\n    }\n  }\n\n  const joined = parseDate(e['Joining Date']);\n  if (joined && matchesToday(joined)) {\n    const years = now.year - joined.year;\n    const key = employeeId + '|work anniversary';\n    if (years >= 1 && !alreadySent.has(key)) {\n      alreadySent.add(key);\n      out.push({ json: { ...base, occasion: 'Work Anniversary', years } });\n    }\n  }\n}\n\n// No matches -> no items -> nothing is sent\nreturn out;"
      },
